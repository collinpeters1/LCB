# camera.py
from picamera2 import Picamera2
import cv2
import time
import os

def capture_image(filename="test.jpg", output_dir="output"):
    # Create output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)
    
    # Initialize and configure the camera using CSI (via Picamera2)
    picam2 = Picamera2()
    config = picam2.create_still_configuration()
    picam2.configure(config)
    
    # Start camera, wait for auto-adjustment, capture image, then stop
    picam2.start()
    time.sleep(2)  # Allow time for the camera to adjust
    image = picam2.capture_array()
    filepath = os.path.join(output_dir, filename)
    cv2.imwrite(filepath, image)
    picam2.stop()
    print(f"Image captured and saved as {filepath}")

if __name__ == "__main__":
    capture_image()
