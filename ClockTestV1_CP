import spidev
import RPi.GPIO as GPIO
import time

# Define the GPIO pin to use for Chip Select (e.g., GPIO8)
CS_PIN = 8

# Setup GPIO for manual chip select
GPIO.setmode(GPIO.BCM)
GPIO.setup(CS_PIN, GPIO.OUT)
GPIO.output(CS_PIN, GPIO.HIGH)  # Ensure CS starts high (inactive)

# Initialize SPI
spi = spidev.SpiDev()
spi.open(0, 0)
spi.max_speed_hz = 500000
spi.no_cs = True  # Disable automatic chip select handling

try:
    while True:
        # Manually drive CS low to enable the device
        GPIO.output(CS_PIN, GPIO.LOW)
        # Send a byte (this will output clock pulses during transmission)
        spi.writebytes([0xAA])
        # Drive CS high to disable the device
        GPIO.output(CS_PIN, GPIO.HIGH)
        # Wait before sending the next byte
        time.sleep(0.5)
except KeyboardInterrupt:
    # Clean up on exit
    pass
finally:
    spi.close()
    GPIO.cleanup()
