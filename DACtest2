#!/usr/bin/env python3
import spidev
import time
import RPi.GPIO as GPIO

# Configuration Constants
LOAD_PIN = 17         # GPIO pin for the LOAD (latch) signal
SPI_CLOCK = 75000     # SPI clock frequency in Hz (75 kHz)
DELAY = 0.1           # Delay in seconds between updates (faster ramp)

# Setup GPIO for the LOAD pin
GPIO.setmode(GPIO.BCM)
GPIO.setup(LOAD_PIN, GPIO.OUT, initial=GPIO.HIGH)

def pulse_load():
    """
    Pulse the LOAD pin low for 1 µs and then wait an extra 10 µs for settling.
    """
    GPIO.output(LOAD_PIN, GPIO.LOW)
    time.sleep(1e-6)  # 1 µs pulse
    GPIO.output(LOAD_PIN, GPIO.HIGH)
    time.sleep(10e-6) # Extra settling time

def update_dac_no_shift(spi, value, range_bit=0, channel=0):
    """
    Update a single DAC channel on the TLC5620C without any additional shifting.

    The 11-bit command word is constructed as:
      [A1 A0 RNG D7 D6 D5 D4 D3 D2 D1 D0]
    where A1 and A0 are the channel select bits,
    RNG is the range select bit,
    and D7-D0 is the 8-bit data.
    
    This 11-bit command word is sent in the lower 11 bits of a 16-bit word:
      00000 A1 A0 RNG D7 D6 D5 D4 D3 D2 D1 D0
    """
    if channel not in [0, 1, 2, 3]:
        raise ValueError("Channel must be 0, 1, 2, or 3")
    if not (0 <= value <= 255):
        raise ValueError("Value must be between 0 and 255")
    if range_bit not in [0, 1]:
        raise ValueError("Range bit must be 0 or 1")
    
    # Construct the 11-bit command word
    command_11 = (channel << 9) | (range_bit << 8) | value
    # Do not shift; place the 11 bits in the lower 11 bits of a 16-bit word
    command_word = command_11

    # Split the 16-bit word into two bytes (big-endian)
    high_byte = (command_word >> 8) & 0xFF
    low_byte = command_word & 0xFF

    # Print the full 16-bit command for debugging
    print(f"Value: {value:3d} -> 16-bit Command: {command_word:016b}")
    print(f"   High byte: {high_byte:08b} | Low byte: {low_byte:08b}")

    # Transmit the command word via SPI
    spi.writebytes([high_byte, low_byte])
    pulse_load()

def main():
    spi = spidev.SpiDev()
    spi.open(0, 0)
    spi.max_speed_hz = SPI_CLOCK  # Set SPI clock to 75 kHz
    spi.mode = 0                  # SPI mode 0

    print("Starting fast DAC ramp test (no shift) with 100 ms delay between updates.\n")
    
    for value in range(256):
        update_dac_no_shift(spi, value, range_bit=0, channel=0)
        time.sleep(DELAY)

    spi.close()
    GPIO.cleanup()

if __name__ == "__main__":
    main()
