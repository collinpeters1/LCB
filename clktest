import spidev
import time

# Open SPI device on bus 0, device 0 (using the default chip select, CE0)
spi = spidev.SpiDev()
spi.open(0, 0)
spi.mode = 0            # SPI mode 0 (clock idles low, data captured on rising edge)
spi.max_speed_hz = 500000  # 500 kHz

# Prepare a burst of dummy data.
data_to_send = [0xAA, 0x55, 0xFF, 0x00]

print("Starting continuous SPI transactions... (Press CTRL+C to stop)")
try:
    while True:
        # This will perform a full SPI transaction.
        # With minimal overhead, the SPI clock (SCLK) will be nearly continuous.
        spi.xfer2(data_to_send)
except KeyboardInterrupt:
    print("SPI test terminated by user.")
finally:
    spi.close()
    print("SPI device closed.")
